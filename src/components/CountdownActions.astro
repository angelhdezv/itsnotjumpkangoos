<section class="countdown-section" aria-labelledby="countdown-title">
    <div class="countdown-net" aria-hidden="true"></div>
    <div class="page-container countdown-section__container">
        <div class="countdown-heading" data-ribbon-anchor>
            <span class="countdown-heading__spark" aria-hidden="true"></span>
            <h2 id="countdown-title">Faltan</h2>
        </div>
        <div class="countdown" aria-live="polite" aria-label="Cuenta regresiva para el cumpleaños">
            <div class="countdown__item"><strong data-countdown-days>00</strong><span>Días</span></div>
            <div class="countdown__item"><strong data-countdown-hours>00</strong><span>Horas</span></div>
            <div class="countdown__item"><strong data-countdown-minutes>00</strong><span>Min</span></div>
            <div class="countdown__item"><strong data-countdown-seconds>00</strong><span>Seg</span></div>
        </div>
        <a class="rsvp-ticket" data-rsvp data-ribbon-anchor data-ribbon-fork href="#">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3z" /><path d="M8.5 8.5c.7 3.7 3.3 6.3 7 7" /></svg>
            <span>Confirmar <strong>asistencia</strong></span>
        </a>
        <div class="quick-actions" data-ribbon-anchor data-ribbon-merge>
            <a class="quick-action quick-action--map" data-maps-link data-ribbon-loop href="#" target="_blank" rel="noopener noreferrer">
                <span class="quick-action__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
                <span>Cómo<br>llegar</span>
            </a>
            <button class="quick-action quick-action--calendar" type="button" data-calendar data-ribbon-loop>
                <span class="quick-action__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4M17 3v4M3 9h18" /><path d="M7 13h2M11 13h2M15 13h2M7 17h2M11 17h2M15 17h2" /></svg></span>
                <span>Calendario</span>
            </button>
            <button class="quick-action quick-action--share" type="button" data-share data-ribbon-loop>
                <span class="quick-action__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.7 10.6 6.6-4.2M8.7 13.4l6.6 4.2" /></svg></span>
                <span>Compartir</span>
            </button>
        </div>
    </div>
</section>
