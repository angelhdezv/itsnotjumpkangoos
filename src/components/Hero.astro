<section class="hero" aria-labelledby="hero-title">
    <div class="hero__decor" aria-hidden="true">
        <span class="blob blob--green-top" data-parallax-speed="0.04"></span>
        <span class="blob blob--blue-right" data-parallax-speed="0.08"></span>
        <span class="confetti confetti--ticket-a"></span>
        <span class="confetti confetti--star-a">★</span>
        <span class="confetti confetti--burst-a"></span>
        <span class="confetti confetti--green-a"></span>
        <span class="confetti confetti--blue-a"></span>
        <span class="confetti confetti--coral-a"></span>
    </div>
    <div class="page-container hero__container">
        <p class="eyebrow" data-ribbon-anchor>Estás invitado</p>
        <div class="photo-card" data-ribbon-anchor>
            <div class="photo-card__image">
                <img src="/assets/images/alex-demo.webp" alt="Niño brincando con los brazos levantados" width="960" height="720" fetchpriority="high">
            </div>
            <p class="photo-card__name">Alex</p>
            <img class="photo-card__kangaroo" src="/assets/images/canguro-amarillo.svg?v=0.0.2-3" alt="" aria-hidden="true">
        </div>
        <header class="hero__copy">
            <h1 id="hero-title">Cumple <span>8</span></h1>
            <p>Brinca <b>•</b> juega <b>•</b> celebra</p>
        </header>
        <a class="scroll-cue" href="#event" data-ribbon-anchor aria-label="Deslizar a los detalles del evento">
            <span>Desliza</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v14M6.5 13l5.5 5 5.5-5" /></svg>
        </a>
    </div>
    <div class="trampoline trampoline--hero" aria-hidden="true">
        <span class="trampoline__rim"></span>
        <span class="trampoline__net"></span>
        <i></i><i></i><i></i><i></i><i></i>
    </div>
</section>
